Change 6: Update classify_intent method to detect crop queries
async def classify_intent(self, state: SharedState) -> SharedState:
    prompt = f"""Classify this query into one category: 'weather', 'crop', or 'unknown'

Query: {state['user_query']}

- 'weather': Questions about temperature, rain, wind, forecast, climate conditions
- 'crop': Questions about farming, crops, what to grow/plant/cultivate, agriculture
- 'unknown': Anything else

Return only the category name without any quotes or extra characters."""
    
    response = await self.llm.ainvoke([("user", prompt)])
    raw_intent = response.content.strip().lower()
    raw_intent = raw_intent.strip(' .!?').strip()
    state["intent"] = raw_intent
    return state

Change 7: Update route_to_agent method
async def route_to_agent(self, state: SharedState) -> str:
    intent = state.get("intent", "unknown")
    if intent == "weather":
        return "weather"
    elif intent == "crop":  # ← ADD THIS BLOCK
        return "crop"
    return "unknown"

